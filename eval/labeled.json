      "lang": "es",
      "category": "A",
      "split": "heldout",
      "revealsOrdinal": 9,
      "expectBlocked": true,
      "text": "El ganador volvió a casa y su madre ya había muerto, con la tarjeta del premio todavía en el bolsillo."
